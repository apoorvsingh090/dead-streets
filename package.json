{
  "name": "dead-streets",
  "version": "1.1.0",
  "private": true,
  "description": "A Left 4 Dead-inspired browser FPS. Four survivors, one city block, no rescue coming.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "electron:dev": "vite --host 127.0.0.1 --port 5173",
    "electron:start": "electron .",
    "dist": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.rustwater.deadstreets",
    "productName": "Dead Streets",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": ["portable"]
    }
  }
}
